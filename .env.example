# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
APP_LOG_LEVEL=INFO

# ── API ──────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://clipper:clipper@localhost:5432/clipper
DATABASE_SYNC_URL=postgresql+psycopg2://clipper:clipper@localhost:5432/clipper

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── Artifact storage ─────────────────────────────────────────────────────────
# "local" | "s3"
ARTIFACT_STORAGE_BACKEND=local
ARTIFACT_LOCAL_ROOT=./artifacts

# ── Security ─────────────────────────────────────────────────────────────────
SECRET_KEY=changeme-replace-in-production
